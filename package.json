{
  "name": "alfaword-games",
  "version": "1.0.0",
  "description": "Cloudflare-hosted Alfaquest word games",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.js",
    "dev": "wrangler dev --env staging --config wrangler.worker.jsonc",
    "serve": "node scripts/simple-http-server.js",
    "test": "npm run test:unit && npm run test:worker && npm run test:games",
    "test:unit": "node --test test/unit/*.test.js",
    "test:worker": "vitest run --config vitest.config.js",
    "test:games": "npm run build && node scripts/test-game-types.js",
    "typecheck": "wrangler types --config wrangler.worker.jsonc --check",
    "check": "npm run test:unit && npm run test:worker && npm run build && npm run typecheck && npm run cf:dry-run",
    "cf:login": "wrangler login",
    "cf:dry-run": "wrangler deploy --dry-run --env=\"\" --config wrangler.worker.jsonc",
    "cf:publish-worker": "wrangler deploy --env=\"\" --config wrangler.worker.jsonc",
    "cf:publish-worker:staging": "wrangler deploy --env staging --config wrangler.worker.jsonc",
    "cf:pages-publish": "wrangler pages deploy dist --project-name=alfaquest-pages --branch=main",
    "cf:deploy:checked": "npm run check && npm run cf:publish-worker && npm run cf:pages-publish"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.2.0",
    "puppeteer-core": "^25.8.0",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  }
}
